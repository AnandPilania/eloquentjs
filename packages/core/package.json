{
  "name": "@eloquentjs/core",
  "version": "0.0.6",
  "description": "Zero-dependency core ORM engine for EloquentJS",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    },
    "./testing": {
      "types": "./dist-types/testing/conformance.d.ts",
      "default": "./src/testing/conformance.js"
    }
  },
  "keywords": [
    "orm",
    "eloquent",
    "nodejs",
    "query-builder"
  ],
  "license": "MIT",
  "author": {
    "name": "Anand Pilania",
    "email": "pilaniaanand@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandPilania/eloquentjs.git"
  },
  "bugs": {
    "url": "https://github.com/AnandPilania/eloquentjs/issues"
  },
  "homepage": "https://github.com/AnandPilania/eloquentjs#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "src",
    "README.md",
    "RESOLVER.md",
    "dist-types"
  ],
  "types": "dist-types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
