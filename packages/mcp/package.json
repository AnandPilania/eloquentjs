{
  "name": "@eloquentjs/mcp",
  "version": "0.0.3",
  "description": "Model Context Protocol server for EloquentJS — lets AI agents query models, run migrations, introspect schemas, and generate code",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "eloquent-mcp": "./bin/server.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./tools": "./src/tools/index.js"
  },
  "keywords": [
    "mcp",
    "ai",
    "agents",
    "orm",
    "eloquent",
    "claude",
    "cursor",
    "windsurf"
  ],
