{
  "name": "@eloquentjs/mcp",
  "version": "0.0.8",
  "description": "Model Context Protocol server for EloquentJS — lets AI agents query models, run migrations, introspect schemas, and generate code",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "eloquent-mcp": "./bin/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./dist-types/server.d.ts",
      "default": "./src/server.js"
    },
    "./tools": {
      "types": "./dist-types/tools/index.d.ts",
      "default": "./src/tools/index.js"
    }
  },
  "keywords": [
    "mcp",
    "ai",
    "agents",
    "orm",
    "eloquent",
    "claude",
    "cursor",
    "windsurf"
  ],
  "license": "MIT",
  "dependencies": {
    "@eloquentjs/core": ">=0.0.8 <0.1.0",
    "@eloquentjs/codegen": ">=0.0.8 <0.1.0",
    "@eloquentjs/cli": ">=0.0.8 <0.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "author": {
    "name": "Anand Pilania",
    "email": "pilaniaanand@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandPilania/eloquentjs.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/AnandPilania/eloquentjs/issues"
  },
  "homepage": "https://github.com/AnandPilania/eloquentjs#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "dist-types"
  ],
  "types": "dist-types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
