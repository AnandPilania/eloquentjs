{
  "name": "@eloquentjs/cli",
  "version": "0.0.7",
  "description": "CLI for EloquentJS — scaffold models, migrations, seeders and more",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "eloquent": "./bin/eloquent.js",
    "ejs": "./bin/eloquent.js"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    },
    "./utils": {
      "types": "./dist-types/utils.d.ts",
      "default": "./src/utils.js"
    },
    "./migration-runner": {
      "types": "./dist-types/commands/migration-runner.d.ts",
      "default": "./src/commands/migration-runner.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "dist-types"
  ],
  "keywords": [
    "orm",
    "eloquent",
    "cli",
    "scaffold",
    "migrations"
  ],
  "license": "MIT",
  "dependencies": {
    "@eloquentjs/core": ">=0.0.7 <0.1.0",
    "@eloquentjs/codegen": ">=0.0.7 <0.1.0"
  },
  "peerDependencies": {
    "@eloquentjs/pgsql": ">=0.0.7 <0.1.0",
    "@eloquentjs/mongodb": ">=0.0.7 <0.1.0",
    "@eloquentjs/sqlite": ">=0.0.7 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@eloquentjs/pgsql": {
      "optional": true
    },
    "@eloquentjs/mongodb": {
      "optional": true
    },
    "@eloquentjs/sqlite": {
      "optional": true
    }
  },
  "author": {
    "name": "Anand Pilania",
    "email": "pilaniaanand@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandPilania/eloquentjs.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AnandPilania/eloquentjs/issues"
  },
  "homepage": "https://github.com/AnandPilania/eloquentjs#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "types": "dist-types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
