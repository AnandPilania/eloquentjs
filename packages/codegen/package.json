{
  "name": "@eloquentjs/codegen",
  "version": "0.0.8",
  "description": "Shared code generation engine for EloquentJS — introspect models, render stubs, emit GraphQL SDL, TypeScript types, OpenAPI specs",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    },
    "./introspect": {
      "types": "./dist-types/introspect.d.ts",
      "default": "./src/introspect.js"
    },
    "./templates": {
      "types": "./dist-types/templates/index.d.ts",
      "default": "./src/templates/index.js"
    },
    "./render": {
      "types": "./dist-types/render.d.ts",
      "default": "./src/render.js"
    }
  },
  "keywords": [
    "orm",
    "eloquent",
    "codegen",
    "graphql",
    "typescript",
    "openapi"
  ],
  "license": "MIT",
  "dependencies": {
    "@eloquentjs/core": ">=0.0.8 <0.1.0"
  },
  "author": {
    "name": "Anand Pilania",
    "email": "pilaniaanand@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandPilania/eloquentjs.git",
    "directory": "packages/codegen"
  },
  "bugs": {
    "url": "https://github.com/AnandPilania/eloquentjs/issues"
  },
  "homepage": "https://github.com/AnandPilania/eloquentjs#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "src",
    "README.md",
    "dist-types"
  ],
  "types": "dist-types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
