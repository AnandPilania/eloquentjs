{
  "name": "@eloquentjs/validator",
  "version": "0.0.9",
  "description": "Full-featured standalone validation for EloquentJS and any Node.js app — sync/async rules, nested fields, fluent schema API, ORM-integrated unique/exists, Express and Fastify adapters",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": {
      "types": "./dist-types/Schema.d.ts",
      "default": "./src/Schema.js"
    },
    "./rule": {
      "types": "./dist-types/Rule.d.ts",
      "default": "./src/Rule.js"
    },
    "./rules": {
      "types": "./dist-types/rules/index.d.ts",
      "default": "./src/rules/index.js"
    },
    "./adapters": {
      "types": "./dist-types/adapters/index.d.ts",
      "default": "./src/adapters/index.js"
    }
  },
  "keywords": [
    "validation",
    "validator",
    "orm",
    "eloquent",
    "express",
    "fastify",
    "zod",
    "yup"
  ],
  "license": "MIT",
  "dependencies": {
    "@eloquentjs/core": ">=0.0.9 <0.1.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "author": {
    "name": "Anand Pilania",
    "email": "pilaniaanand@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandPilania/eloquentjs.git",
    "directory": "packages/validator"
  },
  "bugs": {
    "url": "https://github.com/AnandPilania/eloquentjs/issues"
  },
  "homepage": "https://github.com/AnandPilania/eloquentjs#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "src",
    "README.md",
    "dist-types"
  ],
  "types": "dist-types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
